# Copy to .env and fill in. `.env` is git-ignored.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
ADMIN_USER_IDS=
REGISTER_LINK_SECRET=

# --- BigQuery (Kura data warehouse) ---
# Data lives in project kz-kura (datasets prod_dw, int_dw) in location US.
# Jobs must run in the job project because the bot identity has no jobs.create on kz-kura.
BQ_PROJECT=kz-dp-ops
BQ_LOCATION=US

# --- Optional ---
# DPF_MESSAGE_DELAY_SECONDS=0.25
